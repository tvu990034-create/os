# Minimal package-SDK validation profile for OpenWrt v25.12.6 armsr/armv8.
# The CI build uses DEVICE_TYPE=basic and compiles custom packages only.

CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_armsr_armv8_DEVICE_generic=y

# Core RouterOS packages (DSA is deferred future work)
CONFIG_PACKAGE_router-core=y
CONFIG_PACKAGE_router-net=y
CONFIG_PACKAGE_router-tests=y
CONFIG_PACKAGE_router-ui=y

CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-status=y

# Keep the SDK package job focused on RouterOS packages and dependencies.
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_ip-full is not set
