# Minimal package-SDK validation profile for OpenWrt v25.12.6 x86/64.
# Unlike config/x86_64.config, this does not select the full firmware profile.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y

# Compile every RouterOS feed package and its declared runtime dependencies.
CONFIG_PACKAGE_router-core=y
CONFIG_PACKAGE_router-net=y
CONFIG_PACKAGE_router-dsa-sdk=y
CONFIG_PACKAGE_router-dsa-runtime=y
CONFIG_PACKAGE_router-tests=y
CONFIG_PACKAGE_router-ui=y

# Explicit dependencies needed by the custom package set.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-status=y
