# RouterOS reference configuration for OpenWrt v25.12.6 x86/64.
# Target/profile identifiers are taken from the official 25.12.6 config.buildinfo.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y

# Broad generic-PC Ethernet support (drivers are included as modules).
# Intel: legacy PRO/1000, PCIe gigabit, I210/I211/I225/I226 and 10GbE.
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
# Realtek, Broadcom, Marvell and Qualcomm/Atheros PCIe Ethernet.
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-sky2=y
CONFIG_PACKAGE_kmod-alx=y
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y
# Common virtual-machine and USB Ethernet adapters.
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# Generic PC disk/controller support is enabled by the upstream x86_64 kernel:
# AHCI/SATA, NVMe, USB mass storage and virtio block are built in.
# Generate both legacy BIOS and UEFI bootable ext4 images.
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y


# Standard router services (the UCI overlay configures these). 
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcpd=y

# Upstream packages for QoS and VPN
CONFIG_PACKAGE_tcfilter=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-qosify=y
CONFIG_PACKAGE_openvpn-openssl=y

# Core RouterOS packages (DSA is deferred future work)
CONFIG_PACKAGE_router-core=y
CONFIG_PACKAGE_router-net=y
CONFIG_PACKAGE_router-firewall=y
CONFIG_PACKAGE_router-routing=y
CONFIG_PACKAGE_router-monitor=y
CONFIG_PACKAGE_router-device=y
CONFIG_PACKAGE_router-qos=y
CONFIG_PACKAGE_router-vpn=y
CONFIG_PACKAGE_router-dns=y
CONFIG_PACKAGE_router-dhcp=y
CONFIG_PACKAGE_router-api=y
CONFIG_PACKAGE_router-backup=y
CONFIG_PACKAGE_router-upgrade=y

# Standard LuCI web management interface.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# Keep diagnostics optional in production images:
# CONFIG_PACKAGE_router-tests is not set
# Custom UI replaced with upstream LuCI applications
# CONFIG_PACKAGE_router-ui is not set
