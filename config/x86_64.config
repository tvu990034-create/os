# RouterOS reference configuration for OpenWrt v25.12.6 x86/64.
# Target/profile identifiers are taken from the official 25.12.6 config.buildinfo.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y

# Custom RouterOS packages.
CONFIG_PACKAGE_router-core=y
CONFIG_PACKAGE_router-net=y
CONFIG_PACKAGE_router-dsa-sdk=y
CONFIG_PACKAGE_router-dsa-runtime=y

# Standard LuCI web management interface.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# Keep diagnostics optional in production images:
# CONFIG_PACKAGE_router-tests is not set
# Custom branding/views are not implemented yet:
# CONFIG_PACKAGE_router-ui is not set
