{
	"router-api-read": {
		"description": "Read RouterOS system and network information",
		"read": {
			"ubus": {
				"router-api": [
					"get_system_info",
					"get_network_status",
					"get_monitoring",
					"get_device_info",
					"list_backups"
				]
			},
			"uci": ["system", "network", "firewall", "dhcp"],
			"file": {
				"/usr/libexec/router-core/router-status": "read",
				"/usr/libexec/router-net/check-network-health.sh": "read",
				"/usr/libexec/router-monitor/router-monitor-system": "read",
				"/usr/libexec/router-monitor/router-monitor-network": "read",
				"/usr/libexec/router-device/router-device-info": "read"
			}
		}
	},
	"router-api-write": {
		"description": "Write RouterOS network and DHCP configuration",
		"write": {
			"ubus": {
				"router-api": [
					"backup_config",
					"set_lan_config",
					"set_wan_config",
					"set_dhcp_config"
				]
			},
			"uci": ["network", "dhcp"],
			"file": {
				"/usr/libexec/router-backup/router-backup": "execute"
			}
		}
	},
	"unauthenticated": {
		"description": "No RouterOS management API methods are public"
	}
}
