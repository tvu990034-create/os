#!/usr/bin/ubus
# RouterOS Management API RPC

. /usr/share/libubox/jshn.sh

case "$1" in
	call)
		case "$2" in
			get_system_info)
				/usr/libexec/router-core/router-status
				;;
			get_network_status)
				/usr/libexec/router-net/check-network-health.sh
				;;
			get_monitoring)
				/usr/libexec/router-monitor/router-monitor-system all
				;;
			get_device_info)
				/usr/libexec/router-device/router-device-info all
				;;
			backup_config)
				/usr/libexec/router-backup/router-backup backup
				;;
			list_backups)
				/usr/libexec/router-backup/router-backup list
				;;
			set_lan_config)
				shift 2
				uci set network.lan.ipaddr="$1"
				uci set network.lan.netmask="$2"
				uci commit network
				/etc/init.d/network reload
				echo '{"status":"success"}'
				;;
			set_wan_config)
				shift 2
				uci set network.wan.proto="$1"
				if [ -n "$2" ]; then
					uci set network.wan.ipaddr="$2"
				fi
				uci commit network
				/etc/init.d/network reload
				echo '{"status":"success"}'
				;;
			set_dhcp_config)
				shift 2
				uci set dhcp.lan.start="$1"
				uci set dhcp.lan.limit="$2"
				uci set dhcp.lan.leasetime="$3"
				uci commit dhcp
				/etc/init.d/dnsmasq reload
				echo '{"status":"success"}'
				;;
			set_dns_config)
				shift 2
				uci delete dhcp.lan.dhcp_option
				for server in "$@"; do
					uci add_list dhcp.lan.dhcp_option="6,$server"
				done
				uci commit dhcp
				/etc/init.d/dnsmasq reload
				echo '{"status":"success"}'
				;;
			*)
				echo "Unknown method: $2"
				exit 1
				;;
		esac
		;;
	*)
		echo "Usage: $0 call <method>"
		exit 1
		;;
esac
