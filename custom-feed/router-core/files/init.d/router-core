#!/bin/sh /etc/rc.common
# One-shot RouterOS startup diagnostics. No background process is required.

START=19

start() {
	mkdir -p /tmp/router-core /var/run/router-core
	logger -t router-core "RouterOS startup diagnostics beginning"
	if /usr/libexec/router-core/router-hw-detect > /tmp/router-core/hardware.txt 2>&1; then
		logger -t router-core "Hardware inventory written to /tmp/router-core/hardware.txt"
	else
		logger -t router-core "Hardware inventory failed; see /tmp/router-core/hardware.txt"
	fi
}
