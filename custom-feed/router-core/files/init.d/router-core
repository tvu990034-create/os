#!/bin/sh /etc/rc.common
# Router OS Init Script
# This script runs during system startup

START=99
STOP=10

USE_PROCD=1

start_service() {
	# Log startup
	logger -t router-core "Router OS starting"
	
	# Create runtime directories
	mkdir -p /tmp/router-core
	mkdir -p /var/run/router-core
	
	# Run hardware detection and save to file
	/usr/libexec/router-core/router-hw-detect > /tmp/router-core/hw-detect.log 2>&1
	logger -t router-core "Hardware detection completed"
	
	# No background process needed - this is a one-time init
}

stop_service() {
	logger -t router-core "Router OS stopping"
	
	# Cleanup
	rm -f /var/run/router-core/*
}

reload_service() {
	stop_service
	start_service
}
