#!/bin/sh
# RouterOS configuration backup and restore

BACKUP_DIR="/tmp/routeros-backups"
BACKUP_FILE="$BACKUP_DIR/config-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
MAX_BACKUPS=5

log() {
	logger -t router-backup "$1"
}

create_backup() {
	mkdir -p "$BACKUP_DIR"
	
	# Create backup of UCI configurations
	tar -czf "$BACKUP_FILE" \
		/etc/config/ \
		/etc/uci-defaults/ \
		/etc/dropbear/authorized_keys 2>/dev/null
	
	if [ $? -eq 0 ]; then
		log "Configuration backup created: $BACKUP_FILE"
		echo "Backup created: $BACKUP_FILE"
	else
		log "Failed to create configuration backup"
		echo "ERROR: Backup failed"
		exit 1
	fi
	
	# Clean up old backups (keep only MAX_BACKUPS)
	backup_count=$(ls -1 "$BACKUP_DIR"/config-backup-*.tar.gz 2>/dev/null | wc -l)
	if [ "$backup_count" -gt "$MAX_BACKUPS" ]; then
		ls -1t "$BACKUP_DIR"/config-backup-*.tar.gz 2>/dev/null | tail -n +$((MAX_BACKUPS + 1)) | xargs rm -f
		log "Cleaned up old backups (kept $MAX_BACKUPS most recent)"
	fi
}

list_backups() {
	if [ ! -d "$BACKUP_DIR" ]; then
		echo "No backups found"
		exit 0
	fi
	
	echo "Available backups:"
	ls -lh "$BACKUP_DIR"/config-backup-*.tar.gz 2>/dev/null || echo "No backups found"
}

restore_backup() {
	backup_file=$1
	
	if [ -z "$backup_file" ]; then
		echo "Usage: $0 restore <backup-file>"
		exit 1
	fi
	
	if [ ! -f "$backup_file" ]; then
		echo "Backup file not found: $backup_file"
		exit 1
	fi
	
	# Verify it's a valid tar.gz file
	if ! tar -tzf "$backup_file" >/dev/null 2>&1; then
		echo "Invalid backup file: $backup_file"
		exit 1
	fi
	
	# Create temporary restore directory
	restore_dir="/tmp/routeros-restore-$$"
	mkdir -p "$restore_dir"
	
	# Extract backup
	tar -xzf "$backup_file" -C "$restore_dir"
	
	if [ $? -ne 0 ]; then
		log "Failed to extract backup"
		rm -rf "$restore_dir"
		echo "ERROR: Failed to extract backup"
		exit 1
	fi
	
	# Restore UCI configurations
	if [ -d "$restore_dir/etc/config" ]; then
		cp -r "$restore_dir/etc/config/"* /etc/config/
		log "Restored UCI configurations"
	fi
	
	# Restore UCI defaults (but don't re-run them)
	if [ -d "$restore_dir/etc/uci-defaults" ]; then
		# Only restore custom defaults, not numbered OpenWrt defaults
		find "$restore_dir/etc/uci-defaults" -name "9*" -exec cp {} /etc/uci-defaults/ \; 2>/dev/null
		log "Restored custom UCI defaults"
	fi
	
	# Restore SSH keys if present
	if [ -f "$restore_dir/etc/dropbear/authorized_keys" ]; then
		mkdir -p /etc/dropbear
		cp "$restore_dir/etc/dropbear/authorized_keys" /etc/dropbear/
		log "Restored SSH authorized keys"
	fi
	
	# Clean up
	rm -rf "$restore_dir"
	
	# Reload configurations
	/etc/init.d/firewall reload 2>/dev/null
	/etc/init.d/dnsmasq reload 2>/dev/null
	/etc/init.d/network reload 2>/dev/null
	
	log "Configuration restored from: $backup_file"
	echo "Configuration restored. Network services reloaded."
}

case "${1:-}" in
	backup)
		create_backup
		;;
	list)
		list_backups
		;;
	restore)
		restore_backup "$2"
		;;
	*)
		echo "Usage: $0 {backup|list|restore <backup-file>}"
		exit 1
		;;
esac
