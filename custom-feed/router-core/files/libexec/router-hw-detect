#!/bin/sh
# Read-only hardware inventory for RouterOS diagnostics.

read_sysfs() {
	[ -r "$1" ] || return 0
	IFS= read -r value < "$1" || value=
	[ -n "$value" ] && printf '%s' "$value"
}

detect_network_interfaces() {
	echo "=== Network Interfaces ==="
	if [ ! -d /sys/class/net ]; then
		echo "Network sysfs directory unavailable"
		return
	fi
	for iface_path in /sys/class/net/*; do
		[ -e "$iface_path" ] || continue
		iface=${iface_path##*/}
		echo "Interface: $iface"
		mac="$(read_sysfs "$iface_path/address")"
		state="$(read_sysfs "$iface_path/operstate")"
		carrier="$(read_sysfs "$iface_path/carrier")"
		speed="$(read_sysfs "$iface_path/speed")"
		[ -n "$mac" ] && echo "  MAC: $mac"
		[ -n "$state" ] && echo "  Operational state: $state"
		[ -n "$carrier" ] && echo "  Carrier: $carrier"
		case "$speed" in
			''|-1) ;;
			*[!0-9]*) ;;
			*) echo "  Link speed: ${speed} Mb/s" ;;
		esac
		[ -e "$iface_path/device" ] && echo "  Physical device: yes"
		echo
	done
}

detect_pci_devices() {
	echo "=== PCI Devices ==="
	if command -v lspci >/dev/null 2>&1; then
		lspci 2>/dev/null || echo "No PCI devices reported"
	else
		echo "lspci is not installed"
	fi
	echo
}

detect_cpu_info() {
	echo "=== CPU Information ==="
	if [ -r /proc/cpuinfo ]; then
		grep -E '^(model name|Hardware|CPU architecture|processor|cpu cores)[[:space:]]*:' /proc/cpuinfo | head -20 || true
	else
		echo "/proc/cpuinfo is unavailable"
	fi
	echo
}

detect_memory_info() {
	echo "=== Memory Information ==="
	if [ -r /proc/meminfo ]; then
		grep -E '^(MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo || true
	else
		echo "/proc/meminfo is unavailable"
	fi
	echo
}

detect_storage_info() {
	echo "=== Storage Information ==="
	if [ ! -d /sys/block ]; then
		echo "Block-device sysfs directory unavailable"
		return
	fi
	for block_path in /sys/block/*; do
		[ -e "$block_path" ] || continue
		device=${block_path##*/}
		sectors="$(read_sysfs "$block_path/size")"
		echo "Block device: $device"
		case "$sectors" in
			''|*[!0-9]*) ;;
			*) echo "  Capacity: $((sectors / 2048)) MiB" ;;
		esac
	done
	echo
}

main() {
	echo "======================================"
	echo "RouterOS Hardware Inventory"
	echo "======================================"
	uname -a 2>/dev/null || true
	echo
	detect_network_interfaces
	detect_pci_devices
	detect_cpu_info
	detect_memory_info
	detect_storage_info
	echo "Inventory complete"
}

main "$@"
