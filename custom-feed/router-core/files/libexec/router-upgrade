#!/bin/sh
# RouterOS firmware upgrade helper

FW_DIR="/tmp/firmware"
BACKUP_DIR="/tmp/routeros-backups"
LOG_TAG="router-upgrade"

log() {
	logger -t "$LOG_TAG" "$1"
}

create_pre_upgrade_backup() {
	log "Creating pre-upgrade configuration backup"
	/usr/libexec/router-core/router-backup backup
}

verify_firmware() {
	firmware_file=$1
	
	if [ -z "$firmware_file" ]; then
		echo "Usage: $0 verify <firmware-file>"
		return 1
	fi
	
	if [ ! -f "$firmware_file" ]; then
		echo "ERROR: Firmware file not found: $firmware_file"
		return 1
	fi
	
	# Check file type
	file_type=$(file "$firmware_file")
	echo "Firmware type: $file_type"
	
	# Check if it's a valid image
	if echo "$file_type" | grep -q "gzip compressed"; then
		echo "Compressed firmware detected (gz)"
	elif echo "$file_type" | grep -q "ext4 filesystem"; then
		echo "Ext4 filesystem detected"
	elif echo "$file_type" | grep -q "DOS/MBR"; then
		echo "MBR boot sector detected"
	else
		echo "WARNING: Unknown firmware format"
	fi
	
	# Check file size
	size=$(stat -c%s "$firmware_file")
	echo "Firmware size: $size bytes"
	
	log "Firmware verified: $firmware_file ($size bytes)"
	return 0
}

prepare_upgrade() {
	firmware_file=$1
	
	# Verify firmware first
	if ! verify_firmware "$firmware_file"; then
		log "Firmware verification failed, aborting upgrade"
		return 1
	fi
	
	# Check free space
	if ! check_free_space; then
		log "Insufficient space for upgrade, aborting"
		return 1
	fi
	
	# Create backup
	create_pre_upgrade_backup
	
	# Stop critical services only after validation
	log "Stopping services for upgrade"
	/etc/init.d/uhttpd stop 2>/dev/null
	/etc/init.d/dnsmasq stop 2>/dev/null
	/etc/init.d/network stop 2>/dev/null
	/etc/init.d/firewall stop 2>/dev/null
	
	# Sync filesystems
	sync
	log "Filesystems synced"
	
	log "System prepared for firmware upgrade"
}

sysupgrade_info() {
	if command -v sysupgrade >/dev/null 2>&1; then
		sysupgrade --help 2>/dev/null || true
	else
		echo "sysupgrade command not available"
	fi
}

check_free_space() {
	required_space=$((100 * 1024 * 1024)) # 100MB minimum
	available_space=$(df / | awk 'NR==2 {print $4 * 1024}')
	
	if [ "$available_space" -lt "$required_space" ]; then
		echo "ERROR: Insufficient free space"
		echo "Required: $required_space bytes"
		echo "Available: $available_space bytes"
		return 1
	fi
	
	echo "Free space check passed"
	return 0
}

case "${1:-}" in
	verify)
		verify_firmware "$2"
		;;
	prepare)
		prepare_upgrade "$2"
		;;
	check-space)
		check_free_space
		;;
	info)
		sysupgrade_info
		;;
	*)
		echo "RouterOS Firmware Upgrade Helper"
		echo ""
		echo "Usage: $0 <command> [args]"
		echo ""
		echo "Commands:"
		echo "  verify <file>          Verify firmware file format and size"
		echo "  prepare <file>         Prepare system for upgrade (backup, stop services)"
		echo "  check-space            Check available free space"
		echo "  info                   Show sysupgrade information"
		exit 1
		;;
esac
