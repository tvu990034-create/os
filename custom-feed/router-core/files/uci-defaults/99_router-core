#!/bin/sh
# Router OS UCI Defaults
# This script runs once on first boot to enable Router OS services.

if [ -x /etc/init.d/router-core ]; then
	/etc/init.d/router-core enable
fi

# Keep SSH restricted to the LAN interface. Do not invent or install a
# default root password; access remains governed by the administrator's
# configured credentials and OpenWrt's Dropbear defaults.
if uci -q get dropbear.@dropbear[0] >/dev/null 2>&1; then
	uci set dropbear.@dropbear[0].Interface='lan'
	uci commit dropbear
fi

logger -t router-core "Router OS first-boot defaults applied" 2>/dev/null || true
exit 0
