#!/bin/sh
# RouterOS device capability reporting

LOG_TAG="router-device-capabilities"

log() {
	logger -t "$LOG_TAG" "$1"
}

check_vpn_support() {
	if modinfo ipsec 2>/dev/null >/dev/null || modinfo xfrm 2>/dev/null >/dev/null; then
		echo "IPsec VPN: supported"
	else
		echo "IPsec VPN: not supported"
	fi
	
	if modinfo tun 2>/dev/null >/dev/null || modinfo tap 2>/dev/null >/dev/null; then
		echo "TUN/TAP: supported"
	else
		echo "TUN/TAP: not supported"
	fi
}

check_wifi_support() {
	if lsmod 2>/dev/null | grep -q "mac80211\|cfg80211"; then
		echo "WiFi: supported"
		wlan_count=$(ls /sys/class/net 2>/dev/null | grep -c "^wlan" || echo "0")
		echo "WiFi interfaces: $wlan_count"
	else
		echo "WiFi: not supported"
	fi
}

check_storage_capabilities() {
	if [ -d /sys/block ]; then
		echo "Storage: available"
		blk_devices=$(ls /sys/block 2>/dev/null | wc -l)
		echo "Block devices: $blk_devices"
	else
		echo "Storage: detection failed"
	fi
}

check_pci_devices() {
	if [ -d /sys/bus/pci/devices ]; then
		pci_count=$(ls /sys/bus/pci/devices 2>/dev/null | wc -l)
		echo "PCI devices: $pci_count"
	else
		echo "PCI: not available"
	fi
}

check_usb_devices() {
	if [ -d /sys/bus/usb/devices ]; then
		usb_count=$(ls /sys/bus/usb/devices 2>/dev/null | wc -l)
		echo "USB devices: $usb_count"
	else
		echo "USB: not available"
	fi
}

main() {
	case "${1:-}" in
		vpn)
			check_vpn_support
			;;
		wifi)
			check_wifi_support
			;;
		storage)
			check_storage_capabilities
			;;
		pci)
			check_pci_devices
			;;
		usb)
			check_usb_devices
			;;
		all)
			echo "=== Device Capabilities ==="
			check_vpn_support
			check_wifi_support
			check_storage_capabilities
			check_pci_devices
			check_usb_devices
			;;
		*)
			echo "RouterOS Device Capabilities"
			echo ""
			echo "Usage: $0 <command>"
			echo ""
			echo "Commands:"
			echo "  vpn          Check VPN support"
			echo "  wifi         Check WiFi support"
			echo "  storage      Check storage capabilities"
			echo "  pci          Check PCI devices"
			echo "  usb          Check USB devices"
			echo "  all          Show all capabilities"
			exit 1
			;;
	esac
}

main "$@"
