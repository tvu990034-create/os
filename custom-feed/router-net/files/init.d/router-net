#!/bin/sh /etc/rc.common
# Router OS network monitor service.

START=95
STOP=10
USE_PROCD=1

. /lib/functions.sh

start_service() {
	config_load router-net
	config_get_bool enabled monitor enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get interval monitor interval 10
	case "$interval" in
		''|*[!0-9]*) interval=10 ;;
	esac
	[ "$interval" -ge 1 ] 2>/dev/null || interval=10

	procd_open_instance
	procd_set_param command /usr/libexec/router-net/monitor-interfaces.sh --daemon "$interval"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
