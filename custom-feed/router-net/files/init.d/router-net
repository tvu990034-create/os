#!/bin/sh /etc/rc.common
# Optional, low-overhead observer for network-device state changes.

USE_PROCD=1
START=90

start_service() {
	local enabled interval
	enabled="$(uci -q get router-net.monitor.enabled 2>/dev/null || echo 0)"
	[ "$enabled" = "1" ] || return 0

	interval="$(uci -q get router-net.monitor.interval 2>/dev/null || echo 10)"
	case "$interval" in
		''|*[!0-9]*) interval=10 ;;
	esac
	[ "$interval" -ge 1 ] && [ "$interval" -le 300 ] || interval=10

	procd_open_instance
	procd_set_param command /usr/libexec/router-net/monitor-interfaces.sh --daemon "$interval"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "router-net"
}
