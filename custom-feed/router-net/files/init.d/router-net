#!/bin/sh /etc/rc.common
# Network health monitoring and interface state observation.

USE_PROCD=1
START=90

start_service() {
	# Start interface monitor if enabled
	local enabled interval
	enabled="$(uci -q get router-net.monitor.enabled 2>/dev/null || echo 0)"
	if [ "$enabled" = "1" ]; then
		interval="$(uci -q get router-net.monitor.interval 2>/dev/null || echo 10)"
		case "$interval" in
			''|*[!0-9]*) interval=10 ;;
		esac
		[ "$interval" -ge 1 ] && [ "$interval" -le 300 ] || interval=10

		procd_open_instance monitor
		procd_set_param command /usr/libexec/router-net/monitor-interfaces.sh --daemon "$interval"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# Start health check if enabled
	local health_enabled check_interval
	health_enabled="$(uci -q get router-net.health.enabled 2>/dev/null || echo 1)"
	if [ "$health_enabled" = "1" ]; then
		check_interval="$(uci -q get router-net.health.check_interval 2>/dev/null || echo 30)"
		case "$check_interval" in
			''|*[!0-9]*) check_interval=30 ;;
		esac
		[ "$check_interval" -ge 10 ] && [ "$check_interval" -le 600 ] || check_interval=30

		procd_open_instance health
		procd_set_param command /usr/libexec/router-net/check-network-health.sh
		procd_set_param respawn "${check_interval}" 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "router-net"
	procd_add_reload_trigger "network"
	procd_add_reload_trigger "firewall"
}
